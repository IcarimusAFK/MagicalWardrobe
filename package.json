{
  "name": "magical-wardrobe",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "nuxt dev --port 3001",
    "build": "nuxt build",
    "build:web": "nuxt build",
    "build:api": "node --check src/server.js",
    "start:api": "node src/server.js",
    "start:web": "node .output/server/index.mjs",
    "preview": "nuxt preview --port 3001"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^10.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nuxt": "^4.5.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "20.x"
  }
}
